    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.3",
    "react-router": "8.4.0",
    "sonner": "^2.0.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@tailwindcss/typography": "^0.5.20",
