    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.4",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
